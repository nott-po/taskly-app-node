{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./backend/tests/**)",
      "Edit(./frontend/src/**/*.test.ts)",
      "Edit(./frontend/src/**/*.test.tsx)",
      "Edit(./frontend/src/test/**)",
      "Bash(backend/node_modules/.bin/vitest run *)",
      "Bash(frontend/node_modules/.bin/vitest run *)",
      "Bash(backend/node_modules/.bin/tsc --noEmit -p backend)",
      "Bash(frontend/node_modules/.bin/tsc --noEmit -p frontend)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git diff --output*)",
      "Bash(git diff * --output*)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent/guard-paths.mjs\""
          }
        ]
      }
    ]
  }
}
